{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mmx-live-lyrics",
  "version": "0.1.0",
  "identifier": "com.mmxlive.lyrics",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "直播歌词字幕",
        "width": 960,
        "height": 260,
        "minWidth": 480,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
